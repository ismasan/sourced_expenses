#!/bin/sh
# Keeps README.md's state diagrams in step with the machines in system/.
# Enable once per clone: git config core.hooksPath .githooks
git diff --cached --quiet -- system/ README.md && exit 0

# Git apps (Fork, Tower...) don't load the shell's profile, so `ruby` is
# the system's, too old for the app: put a version manager's shims first,
# for the project's Ruby (.ruby-version).
for shims in "$HOME/.rbenv/shims" "$HOME/.local/share/mise/shims" "$HOME/.asdf/shims"; do
  if [ -d "$shims" ]; then
    PATH="$shims:$PATH"
    export PATH
    break
  fi
done

# With unstaged README.md edits, staging the file would sneak them into
# this commit, so only check and let the user fix it.
if ! git diff --quiet -- README.md; then
  bin/readme-diagrams --check && exit 0
  echo "pre-commit: README.md diagrams are out of date; run bin/readme-diagrams and stage README.md" >&2
  exit 1
fi

bin/readme-diagrams || exit 1
if ! git diff --quiet -- README.md; then
  git add README.md
  echo "pre-commit: updated README.md diagrams and added them to this commit"
fi
